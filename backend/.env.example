# AeroSense Backend Environment Variables

# App Mode: LIVE or DEMO
APP_MODE=DEMO

# SQLite Database URL
DATABASE_URL=sqlite:///./data/aerosense.db

# CPCB API Key (Required for LIVE mode)
CPCB_API_KEY=

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend URL (For CORS)
FRONTEND_URL=http://localhost:3000

# Logging Level
LOG_LEVEL=INFO
